+static int wpas_p2p_is_kernel_netdev(const char *ifname)
+{
+	const char *pos;
+
+	if (os_strncmp(ifname, "p2p", 3) != 0 || ifname[3] == '\0')
+		return 0;
+
+	for (pos = ifname + 3; *pos; pos++) {
+		if (*pos < '0' || *pos > '9')
+			return 0;
+	}
+
+	return 1;
+}
 
 
