+void cleanupStaleIfaceArtifacts(struct wpa_global* wpa_global, const std::string& name,
+				const char* type)
+{
+	struct wpa_supplicant* stale_iface =
+		wpa_supplicant_get_iface(wpa_global, name.c_str());
+	if (stale_iface) {
+		wpa_printf(MSG_INFO, "Removing stale %s iface %s before retrying add",
+			   type, name.c_str());
+		wpa_supplicant_remove_iface(wpa_global, stale_iface, 0);
+	}
+
+	std::string ctrl_iface_path = std::string(kCtrlIfaceDir) + "/" + name;
+	if (unlink(ctrl_iface_path.c_str()) == 0) {
+		wpa_printf(MSG_INFO, "Removed stale ctrl_iface socket %s",
+			   ctrl_iface_path.c_str());
+	} else if (errno != ENOENT) {
+		wpa_printf(MSG_DEBUG, "Failed to remove stale ctrl_iface socket %s: %s",
+			   ctrl_iface_path.c_str(), strerror(errno));
+	}
+}
