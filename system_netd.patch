@@ -38,6 +38,7 @@
 #include <sys/stat.h>
 #include <sys/types.h>
 #include <sys/wait.h>
+#include <unistd.h>
 
 #include <linux/netlink.h>
 #include <linux/rtnetlink.h>
@@ -258,6 +259,33 @@ std::vector<std::string> getBasicAccountingCommands() {
     return ipt_basic_accounting_commands;
 }
 
+bool haveXtBpfPrograms() {
+    return !access(XT_BPF_DENYLIST_PROG_PATH, R_OK) && !access(XT_BPF_ALLOWLIST_PROG_PATH, R_OK) &&
+            !access(XT_BPF_INGRESS_PROG_PATH, R_OK) && !access(XT_BPF_EGRESS_PROG_PATH, R_OK);
+}
+
+std::vector<std::string> getBasicAccountingCommandsLegacy() {
+    // SM-P205 bring-up currently uses the stock 4.4 kernel without BPF syscall
+    // support. Keep netd alive with the non-BPF accounting skeleton until the
+    // kernel is rebuilt with the Android BPF requirements.
+    std::vector<std::string> ipt_basic_accounting_commands = {
+            "*filter",
+            "-A bw_INPUT -j bw_global_alert",
+            "-A bw_OUTPUT -j bw_global_alert",
+            "-A bw_costly_shared -j bw_penalty_box",
+            "-A bw_penalty_box -j bw_happy_box",
+            "-A bw_happy_box -j bw_data_saver",
+            "-A bw_data_saver -j RETURN",
+            "COMMIT",
+            "*raw",
+            StringPrintf("-A bw_raw_PREROUTING -m mark --mark 0x%x -j DROP", CLAT_MARK),
+            "COMMIT",
+            "*mangle",
+            StringPrintf("-A bw_mangle_POSTROUTING -j MARK --set-mark 0x0/0x%x", uidBillingMask),
+            COMMIT_AND_CLOSE};
+    return ipt_basic_accounting_commands;
+}
+
 }  // namespace
 
 BandwidthController::BandwidthController() {
@@ -286,7 +314,13 @@ int BandwidthController::enableBandwidthControl() {
 
     flushCleanTables(false);
 
-    std::string commands = Join(getBasicAccountingCommands(), '\n');
+    const auto commandsList = haveXtBpfPrograms()
+            ? getBasicAccountingCommands()
+            : getBasicAccountingCommandsLegacy();
+    if (!haveXtBpfPrograms()) {
+        ALOGW("xt_bpf programs are unavailable; enabling legacy bandwidth hooks for bring-up");
+    }
+    std::string commands = Join(commandsList, '\n');
     return iptablesRestoreFunction(V4V6, commands, nullptr);
 }
 
