+#include <openssl/base.h>
+
+#include <stddef.h>
+#include <stdint.h>
+
+struct cbs_st {
+  const uint8_t *data;
+  size_t len;
+};
+
+extern "C" OPENSSL_EXPORT void CBS_init(CBS *cbs, const uint8_t *data,
+                                        size_t len) {
+  cbs->data = data;
+  cbs->len = len;
+}
