+
+    protected static void syncDoubleTapToWake(Context context) {
+        if (!context.getResources().getBoolean(
+                com.android.internal.R.bool.config_supportDoubleTapWake)) {
+            return;
+        }
+
+        final int enabled = Settings.Secure.getIntForUser(context.getContentResolver(),
+                DOUBLE_TAP_TO_WAKE, 1, UserHandle.USER_CURRENT);
+        if (enabled != 0) {
+            // SettingsProvider ignores same-value writes; force the Power HAL hint to replay.
+            Settings.Secure.putIntForUser(context.getContentResolver(), DOUBLE_TAP_TO_WAKE, 0,
+                    UserHandle.USER_CURRENT);
+            SystemClock.sleep(250);
+            Settings.Secure.putIntForUser(context.getContentResolver(), DOUBLE_TAP_TO_WAKE, 1,
+                    UserHandle.USER_CURRENT);
+        } else {
+            Settings.Secure.putIntForUser(context.getContentResolver(), DOUBLE_TAP_TO_WAKE, 0,
+                    UserHandle.USER_CURRENT);
