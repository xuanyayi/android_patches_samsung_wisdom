+        if (!context.getResources().getBoolean(
+                com.android.internal.R.bool.config_supportDoubleTapWake)) {
+            return;
+        }
+
+        final int enabled = Settings.Secure.getIntForUser(context.getContentResolver(),
+                DOUBLE_TAP_TO_WAKE, 1, UserHandle.USER_CURRENT);
