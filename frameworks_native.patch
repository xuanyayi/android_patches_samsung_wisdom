+void TouchInputMapper::suppressFingerPointersWhenStylusIsActive() {
+    CookedPointerData& currentPointerData = mCurrentCookedState.cookedPointerData;
+
+    bool hasActiveStylus = false;
+    for (uint32_t i = 0; i < currentPointerData.pointerCount; i++) {
+        const uint32_t id = currentPointerData.pointerProperties[i].id;
+        if ((currentPointerData.touchingIdBits.hasBit(id) ||
+             currentPointerData.hoveringIdBits.hasBit(id)) &&
+            isStylusPointerToolType(currentPointerData.pointerProperties[i].toolType)) {
+            hasActiveStylus = true;
+            break;
+        }
+    }
+    if (!hasActiveStylus) {
+        return;
+    }
+
+    uint32_t outCount = 0;
+    for (uint32_t i = 0; i < currentPointerData.pointerCount; i++) {
+        PointerProperties& properties = currentPointerData.pointerProperties[i];
+        const uint32_t id = properties.id;
+        if (shouldSuppressWhenStylusIsActive(properties.toolType)) {
+            currentPointerData.touchingIdBits.clearBit(id);
+            currentPointerData.hoveringIdBits.clearBit(id);
+            currentPointerData.validIdBits.clearBit(id);
+            if (mLastCookedState.cookedPointerData.touchingIdBits.hasBit(id)) {
+                currentPointerData.canceledIdBits.markBit(id);
+            } else {
+                currentPointerData.canceledIdBits.clearBit(id);
+            }
+            continue;
+        }
+
+        if (outCount != i) {
+            currentPointerData.pointerProperties[outCount].copyFrom(properties);
+            currentPointerData.pointerCoords[outCount].copyFrom(currentPointerData.pointerCoords[i]);
+        }
+        currentPointerData.idToIndex[id] = outCount;
+        outCount++;
+    }
+    currentPointerData.pointerCount = outCount;
+}
