+    private static Size getBoundedThumbnailSize(Size requestedSize) {
+        int maxDimension = Math.max(requestedSize.getWidth(), requestedSize.getHeight());
+        if (maxDimension <= MAX_THUMBNAIL_SIZE_PX) {
+            return requestedSize;
+        }
+
+        float scale = (float) MAX_THUMBNAIL_SIZE_PX / maxDimension;
+        return new Size(
+                Math.max(1, Math.round(requestedSize.getWidth() * scale)),
+                Math.max(1, Math.round(requestedSize.getHeight() * scale)));
+    }
+
+    private static Bitmap getBoundedThumbnailBitmap(Bitmap thumbnailBitmap) {
+        int maxDimension = Math.max(thumbnailBitmap.getWidth(), thumbnailBitmap.getHeight());
+        if (maxDimension <= MAX_THUMBNAIL_SIZE_PX) {
+            return thumbnailBitmap;
+        }
+
+        float scale = (float) MAX_THUMBNAIL_SIZE_PX / maxDimension;
+        Bitmap scaledBitmap = Bitmap.createScaledBitmap(
+                thumbnailBitmap,
+                Math.max(1, Math.round(thumbnailBitmap.getWidth() * scale)),
+                Math.max(1, Math.round(thumbnailBitmap.getHeight() * scale)),
+                true);
+        if (scaledBitmap != thumbnailBitmap) {
+            thumbnailBitmap.recycle();
+        }
+        return scaledBitmap;
+    }
