+
+static int add_dai_link(struct audio_route *ar, const char *name, const char *value)
+{
+    int index;
+    long link;
+
+    index = dai_link_index_for_name(name);
+    if (index < 0)
+        return 0;
+
+    if (!safe_strtol(value, &link) || link < -1 || link > INT_MAX) {
+        ALOGE("Invalid dai link value '%s' for '%s'", value, name);
+        return -1;
+    }
+
+    ar->dai_link[index] = link;
+
+    return 0;
+}
