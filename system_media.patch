+static int dai_link_index_for_name(const char *name)
+{
+    unsigned int i;
+
+    for (i = 0; i < DAI_LINK_COUNT; i++)
+        if (strcmp(name, dai_link_names[i]) == 0)
+            return i;
+
+    return -1;
