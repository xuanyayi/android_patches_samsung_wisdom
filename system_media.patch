+static int include_xml(struct audio_route *ar, const char *parent_xml_path, const char *include_path)
+{
+    char resolved_path[PATH_MAX];
+    const char *slash;
+    size_t dir_len;
+
+    if (!include_path || include_path[0] == '\0')
+        return -1;
+
+    if (include_path[0] == '/')
+        return parse_xml(ar, include_path);
+
+    if (!parent_xml_path)
+        return parse_xml(ar, include_path);
+
+    slash = strrchr(parent_xml_path, '/');
+    if (!slash)
+        return parse_xml(ar, include_path);
+
+    dir_len = slash - parent_xml_path + 1;
+    if (dir_len + strlen(include_path) >= sizeof(resolved_path)) {
+        ALOGE("Include path is too long: %s/%s", parent_xml_path, include_path);
+        return -1;
+    }
+
+    memcpy(resolved_path, parent_xml_path, dir_len);
+    strcpy(resolved_path + dir_len, include_path);
+    return parse_xml(ar, resolved_path);
+}
