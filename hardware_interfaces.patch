diff --git a/bluetooth/1.0/default/bluetooth_address.cc b/bluetooth/1.0/default/bluetooth_address.cc
index 93a546995..b0e3b2cb6 100644
--- a/bluetooth/1.0/default/bluetooth_address.cc
+++ b/bluetooth/1.0/default/bluetooth_address.cc
@@ -28,6 +28,47 @@ namespace bluetooth {
 namespace V1_0 {
 namespace implementation {
 
+namespace {
+
+static constexpr char SERIALNO_PROPERTY[] = "ro.serialno";
+static constexpr char BOOT_SERIALNO_PROPERTY[] = "ro.boot.serialno";
+static constexpr uint64_t FNV1A_64_OFFSET_BASIS = 14695981039346656037ULL;
+static constexpr uint64_t FNV1A_64_PRIME = 1099511628211ULL;
+
+uint64_t fnv1a_hash(const char* value) {
+  uint64_t hash = FNV1A_64_OFFSET_BASIS;
+  for (const char* p = value; *p != '\0'; ++p) {
+    hash ^= static_cast<uint8_t>(*p);
+    hash *= FNV1A_64_PRIME;
+  }
+  return hash;
+}
+
+bool get_address_from_serial(uint8_t* local_addr) {
+  char serial[PROPERTY_VALUE_MAX] = {0};
+  if (!property_get(SERIALNO_PROPERTY, serial, NULL)) {
+    property_get(BOOT_SERIALNO_PROPERTY, serial, NULL);
+  }
+
+  if (serial[0] == '\0') {
+    return false;
+  }
+
+  const uint64_t hash = fnv1a_hash(serial);
+  local_addr[0] = 0x02;
+  for (size_t i = 1; i < BluetoothAddress::kBytes; ++i) {
+    local_addr[i] = (hash >> ((i - 1) * 8)) & 0xff;
+  }
+
+  char address[BluetoothAddress::kStringLength + 1] = {0};
+  BluetoothAddress::bytes_to_string(local_addr, address);
+  ALOGW("%s: Using local fallback BDA %s derived from serial", __func__,
+        address);
+  return true;
+}
+
+}  // namespace
+
 void BluetoothAddress::bytes_to_string(const uint8_t* addr, char* addr_str) {
   sprintf(addr_str, "%02x:%02x:%02x:%02x:%02x:%02x", addr[0], addr[1], addr[2],
           addr[3], addr[4], addr[5]);
@@ -87,7 +128,7 @@ bool BluetoothAddress::get_local_address(uint8_t* local_addr) {
     return true;
   }
 
-  return false;
+  return get_address_from_serial(local_addr);
 }
 
 }  // namespace implementation
