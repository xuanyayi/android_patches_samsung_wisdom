+        }
+        buf += n;
+        len -= n;
+    }
+    return 0;
+}
+
+static int pwriteExact(int fd, const void* data, size_t len, off64_t offset) {
+    const char* buf = static_cast<const char*>(data);
+    while (len > 0) {
+        ssize_t n = TEMP_FAILURE_RETRY(::pwrite64(fd, buf, len, offset));
+        if (n < 0) return -1;
+        if (n == 0) {
+            errno = EIO;
+            return -1;
+        }
+        buf += n;
+        len -= n;
+        offset += n;
+    }
+    return 0;
+}
 
