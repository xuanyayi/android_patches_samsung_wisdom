+constexpr int kSamsungMtpWriteIntData = 4;
+constexpr int kSamsungMtpSetZlpData = 9;
+constexpr int kSamsungMtpGetBulkPacketSize = 10;
+constexpr int kDefaultBulkPacketSize = 512;
+constexpr int kSamsungLegacyBufferSize = 32768;
+constexpr uint32_t kMaxMtpFileSize = 0xFFFFFFFF;
