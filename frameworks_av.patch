 int MtpDevHandle::sendFile(mtp_file_range mfr) {
+    if (mSamsungLegacy) {
+        if (mfr.length < 0 || mfr.offset < 0) {
+            errno = EINVAL;
+            return -1;
+        }
+
+        std::vector<unsigned char> buffer(kSamsungLegacyBufferSize);
+        uint64_t file_length = mfr.length;
+        uint32_t given_length = std::min(static_cast<uint64_t>(kMaxMtpFileSize),
+                file_length + sizeof(mtp_data_header));
+        uint64_t offset = mfr.offset;
+
+        mtp_data_header* header = reinterpret_cast<mtp_data_header*>(buffer.data());
+        header->length = htole32(given_length);
+        header->type = htole16(MTP_CONTAINER_TYPE_DATA);
+        header->command = htole16(mfr.command);
+        header->transaction_id = htole32(mfr.transaction_id);
+
+        size_t init_read_len = std::min(static_cast<uint64_t>(
+                std::max(mBulkPacketSize - static_cast<int>(sizeof(mtp_data_header)), 0)),
+                file_length);
+        ssize_t ret = TEMP_FAILURE_RETRY(::pread64(mfr.fd,
+                buffer.data() + sizeof(mtp_data_header), init_read_len, offset));
+        if (ret != static_cast<ssize_t>(init_read_len)) {
+            if (ret >= 0) errno = EIO;
+            return -1;
+        }
+        if (writeExact(mFd, buffer.data(), sizeof(mtp_data_header) + init_read_len) < 0) {
+            return -1;
+        }
+
+        file_length -= init_read_len;
+        offset += init_read_len;
+        int last_write = sizeof(mtp_data_header) + init_read_len;
+
+        while (file_length > 0) {
+            size_t length = std::min(static_cast<uint64_t>(buffer.size()), file_length);
+            ret = TEMP_FAILURE_RETRY(::pread64(mfr.fd, buffer.data(), length, offset));
+            if (ret < 0) return -1;
+            if (ret == 0) {
+                errno = EIO;
+                return -1;
+            }
+            if (static_cast<size_t>(ret) < length) {
+                errno = EIO;
+                return -1;
+            }
+
+            if (writeExact(mFd, buffer.data(), ret) < 0) return -1;
+
+            file_length -= ret;
+            offset += ret;
+            last_write = ret;
+        }
+
+        if (last_write % mBulkPacketSize == 0) {
+            if (ioctl(mFd, kSamsungMtpSetZlpData) < 0) return -1;
+        }
+        return 0;
+    }
+
     return ioctl(mFd, MTP_SEND_FILE_WITH_HEADER, reinterpret_cast<unsigned long>(&mfr));
 }
 
 int MtpDevHandle::sendEvent(mtp_event me) {
+    if (mSamsungLegacy) {
+        int ret = ioctl(mFd, kSamsungMtpWriteIntData, reinterpret_cast<unsigned long>(&me));
+        return ret < 0 ? -1 : 0;
+    }
+
     return ioctl(mFd, MTP_SEND_EVENT, reinterpret_cast<unsigned long>(&me));
 }
 
 int MtpDevHandle::start(bool /* ptp */) {
     mFd.reset(TEMP_FAILURE_RETRY(open(mtp_dev_path, O_RDWR)));
     if (mFd == -1) return -1;
+
+    mSamsungLegacy = true;
+    int packet_size = ioctl(mFd, kSamsungMtpGetBulkPacketSize);
+    if (packet_size > 0) {
+        mBulkPacketSize = packet_size;
+        LOG(INFO) << "Using Samsung legacy MTP gadget with bulk packet size " << mBulkPacketSize;
+    } else {
+        PLOG(WARNING) << "Using Samsung legacy MTP gadget with default bulk packet size "
+                      << mBulkPacketSize;
+    }
     return 0;
 }
 
