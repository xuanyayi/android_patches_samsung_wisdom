+struct mtp_data_header {
+    uint32_t length;
+    uint16_t type;
+    uint16_t command;
+    uint32_t transaction_id;
+};
+
+static int writeExact(int fd, const void* data, size_t len) {
+    const char* buf = static_cast<const char*>(data);
+    while (len > 0) {
+        ssize_t n = TEMP_FAILURE_RETRY(::write(fd, buf, len));
+        if (n < 0) return -1;
+        if (n == 0) {
+            errno = EIO;
+            return -1;
+        }
+        buf += n;
+        len -= n;
+    }
+    return 0;
+}
+
+static int pwriteExact(int fd, const void* data, size_t len, off64_t offset) {
+    const char* buf = static_cast<const char*>(data);
+    while (len > 0) {
+        ssize_t n = TEMP_FAILURE_RETRY(::pwrite64(fd, buf, len, offset));
+        if (n < 0) return -1;
+        if (n == 0) {
+            errno = EIO;
+            return -1;
+        }
+        buf += n;
+        len -= n;
+        offset += n;
+    }
+    return 0;
+}
 
