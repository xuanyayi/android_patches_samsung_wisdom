+static const char * wpa_driver_slsi_p2p_ifname(const struct i802_bss *bss,
+					       char *ifname, size_t ifname_len)
+{
+	os_strlcpy(ifname, "p2p0", ifname_len);
+
+	if (ifname[0] && if_nametoindex(ifname))
+		return ifname;
+
+	return bss->ifname;
