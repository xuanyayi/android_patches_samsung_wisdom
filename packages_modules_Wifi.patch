+    /**
+     * Some vendor supplicants create the STA iface while returning an error when asked to add it.
+     * Reuse that iface so Wi-Fi can recover after a disable/enable cycle.
+     */
+    private ISupplicantStaIface getExistingStaIfaceFromSupplicant(@NonNull String ifaceName) {
+        synchronized (mLock) {
+            try {
+                for (IfaceInfo ifaceInfo : mISupplicant.listInterfaces()) {
+                    if (ifaceInfo.type == IfaceType.STA && ifaceName.equals(ifaceInfo.name)) {
+                        return mISupplicant.getStaInterface(ifaceName);
+                    }
+                }
+            } catch (RemoteException e) {
+                handleRemoteException(e, "getExistingStaIfaceFromSupplicant");
+            } catch (ServiceSpecificException e) {
+                handleServiceSpecificException(e, "getExistingStaIfaceFromSupplicant");
+            } catch (NoSuchElementException | IllegalArgumentException e) {
+                Log.e(TAG, "Encountered exception at getExistingStaIfaceFromSupplicant: ", e);
+            }
+            return null;
+        }
+    }
