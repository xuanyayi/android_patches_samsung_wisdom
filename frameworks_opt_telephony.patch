+    private void dialPendingGsmMo(int clirMode, UUSInfo uusInfo) {
+        if (mPendingMO == null) {
+            log("dialPendingGsmMo: no pending MO");
+            restoreCsNetworkAfterGsmDial();
+            return;
+        }
+
+        mCi.dial(mPendingMO.getAddress(), mPendingMO.isEmergencyCall(),
+                mPendingMO.getEmergencyNumberInfo(), mPendingMO.hasKnownUserIntentEmergency(),
+                clirMode, uusInfo, obtainCompleteMessage());
+        mPendingGsmDialClirMode = CommandsInterface.CLIR_DEFAULT;
+        mPendingGsmDialUusInfo = null;
+        mCsfbRatWaitAttempts = 0;
+    }
+
+    private void disconnectPendingGsmMo(int cause) {
+        if (mPendingMO == null) {
+            log("disconnectPendingGsmMo: no pending MO");
+            restoreCsNetworkAfterGsmDial();
+            return;
+        }
+
+        mPendingMO.mCause = cause;
+        mPendingGsmDialClirMode = CommandsInterface.CLIR_DEFAULT;
+        mPendingGsmDialUusInfo = null;
+        mCsfbRatWaitAttempts = 0;
+        restoreCsNetworkAfterGsmDial();
+        pollCallsWhenSafe();
+    }
+
+    private void restoreCsNetworkAfterGsmDial() {
+        if (!mCsfbNetworkOverrideActive) {
+            return;
+        }
+
+        log("restoreCsNetworkAfterGsmDial: networkType=" + mCsfbRestoreNetworkType);
+        mCsfbNetworkOverrideActive = false;
+        mCi.setPreferredNetworkType(mCsfbRestoreNetworkType,
+                obtainMessage(EVENT_RESTORE_CS_NETWORK_TYPE_DONE));
+    }
+
+    private void clearCsNetworkOverrideState() {
+        mCsfbNetworkOverrideActive = false;
+        mRestoreCsNetworkOnRadioAvailable = false;
+        mCsfbRestoreNetworkType = RILConstants.NETWORK_MODE_LTE_GSM_WCDMA;
+        mPendingGsmDialClirMode = CommandsInterface.CLIR_DEFAULT;
+        mPendingGsmDialUusInfo = null;
+        mCsfbRatWaitAttempts = 0;
+    }
+
+    private void restoreCsNetworkAfterRadioAvailable() {
+        if (!mRestoreCsNetworkOnRadioAvailable) {
+            return;
+        }
+
+        log("restoreCsNetworkAfterRadioAvailable: networkType=" + mCsfbRestoreNetworkType);
+        mRestoreCsNetworkOnRadioAvailable = false;
+        mCsfbNetworkOverrideActive = false;
+        mCi.setPreferredNetworkType(mCsfbRestoreNetworkType,
+                obtainMessage(EVENT_RESTORE_CS_NETWORK_TYPE_DONE));
+    }
+
+    private void dialPendingGsmMoWhenCsRatReady() {
+        int rat = mPhone.getServiceState().getRilVoiceRadioTechnology();
+        if (rat != ServiceState.RIL_RADIO_TECHNOLOGY_UNKNOWN && !ServiceState.isPsOnlyTech(rat)) {
+            log("dialPendingGsmMoWhenCsRatReady: CS RAT ready, rat="
+                    + ServiceState.rilRadioTechnologyToString(rat));
+            dialPendingGsmMo(mPendingGsmDialClirMode, mPendingGsmDialUusInfo);
+            return;
+        }
+
+        if (mCsfbRatWaitAttempts >= CSFB_MAX_RAT_WAIT_ATTEMPTS) {
+            Rlog.w(LOG_TAG, "CS RAT did not become ready; not dialing on PS-only RAT, rat="
+                    + ServiceState.rilRadioTechnologyToString(rat));
+            disconnectPendingGsmMo(DisconnectCause.OUT_OF_SERVICE);
+            return;
+        }
+
+        mCsfbRatWaitAttempts++;
+        sendMessageDelayed(obtainMessage(EVENT_DIAL_AFTER_CS_NETWORK_TYPE),
+                CSFB_RAT_POLL_DELAY_MILLIS);
+    }
